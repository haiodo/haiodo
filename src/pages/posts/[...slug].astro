---
import { getCollection } from "astro:content";
import Post from "../../layouts/Post.astro";

export async function getStaticPaths() {
  const translated = new Set((await getCollection("postsEn")).map((e) => e.id));
  const posts = await getCollection("posts");
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, alternate: translated.has(entry.id) ? `/en/posts/${entry.id}` : undefined },
  }));
}

const { entry, alternate } = Astro.props;
---

<Post entry={entry} lang="ru" alternate={alternate} />

---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("posts"))
  .filter((entry) => entry.id !== "overview")
  .sort((a, b) => {
    const byDate = (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0);
    // При одинаковой дате порядок задаёт sidebar.order: иначе два поста одного
    // дня встают в порядке имён файлов, то есть старый оказывается сверху.
    return byDate || (b.data.sidebar?.order ?? 0) - (a.data.sidebar?.order ?? 0);
  });

// Значок "Новое" ставится сам верхнему посту, чтобы не снимать его руками с
// предыдущего при каждой публикации. Свой значок во frontmatter перекрывает.
const newestId = posts[0]?.id;
---

<Base title="Статьи - Андрей Соболев" description="Все статьи блога">
  <h1 class="prompt">ls -la posts/</h1>
  {
    posts.map((entry) => {
      const badge = entry.data.sidebar?.badge;
      const badgeText =
        (typeof badge === "string" ? badge : badge?.text) ??
        (entry.id === newestId ? "Новое" : undefined);
      return (
        <a class="row" href={`/posts/${entry.id}`}>
          <span class="row-head">
            <span class="row-title">
              <span class="post-date">
                {entry.data.date?.toISOString().slice(0, 10)}
              </span>
              {entry.data.title}
            </span>
            <span class="row-meta">
              {badgeText && <span class="badge">{badgeText}</span>}
            </span>
          </span>
          {entry.data.description && <p class="row-desc">{entry.data.description}</p>}
        </a>
      );
    })
  }
</Base>

<style>
  .post-date {
    color: var(--fg-faint);
    margin-right: 0.6rem;
  }
</style>

---
import { getCollection } from "astro:content";
import Post from "../../../layouts/Post.astro";

// An English post shares its id with the Russian original; some have none.
export async function getStaticPaths() {
  const translated = new Set((await getCollection("posts")).map((e) => e.id));
  const posts = await getCollection("postsEn");
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, alternate: translated.has(entry.id) ? `/posts/${entry.id}` : undefined },
  }));
}

const { entry, alternate } = Astro.props;
---

<Post entry={entry} lang="en" alternate={alternate} />

---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Image, getImage } from "astro:assets";
import Base from "./Base.astro";

interface Props {
  entry: CollectionEntry<"posts"> | CollectionEntry<"postsEn">;
  lang: "ru" | "en";
  /** Address of the same post in the other language, if translated. */
  alternate?: string;
}

const { entry, lang, alternate } = Astro.props;
const { Content } = await render(entry);
const hero = entry.data.hero?.image?.file;

// The header renders a 320px square crop; the lightbox needs the uncropped original.
const heroFull = hero
  ? await getImage({ src: hero, width: 1600, format: "webp", quality: 85 })
  : undefined;
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  image={hero}
  type="article"
  publishedAt={entry.data.date}
  lang={lang}
  alternate={alternate}
>
  <header class:list={["post-header", { "with-hero": hero }]}>
    {hero && (
      <Image
        class="hero"
        src={hero}
        alt={entry.data.title}
        width={320}
        height={320}
        format="webp"
        quality={80}
        loading="eager"
        data-full={heroFull?.src}
      />
    )}
    <div class="post-head-text">
      <h1>{entry.data.title}</h1>
      {entry.data.date && (
        <p class="post-meta">
          <time datetime={entry.data.date.toISOString()}>
            {entry.data.date.toISOString().slice(0, 10)}
          </time>
          {alternate && (
            <a class="alt-lang" href={alternate} hreflang={lang === "ru" ? "en" : "ru"}>
              {lang === "ru" ? "English version" : "Русская версия"}
            </a>
          )}
        </p>
      )}
      {entry.data.description && <p class="muted">{entry.data.description}</p>}
    </div>
  </header>
  <Content />
</Base>

<style>
  .post-header.with-hero {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .post-head-text {
    min-width: 0;
  }

  .post-header h1 {
    margin-top: 0;
  }

  .hero {
    width: 160px;
    height: 160px;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: 12px;
    flex-shrink: 0;
    margin-top: 0.35rem;
  }

  .post-meta {
    color: var(--fg-faint);
    font-size: 0.875rem;
    margin: -0.5rem 0 0.75rem;
  }

  .alt-lang {
    margin-left: 1rem;
  }

  @media (max-width: 34rem) {
    .post-header.with-hero {
      flex-direction: column;
      gap: 1rem;
    }

    .hero {
      width: 112px;
      height: 112px;
    }
  }
</style>

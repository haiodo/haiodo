// Карта проекта для статьи в блоге: план релиза, цикл фичи, команда и продуктовая модель.
element "Release plan" {
    styles {
        item {
            font-size 18
            border-color #000000
        }
    }
    item "Q1" {
        pos 0 430
        width 160
        color #ffffff
        text-color #111111
    }
    item "Q2" {
        pos 200 430
        width 160
        color #ffffff
        text-color #111111
    }
    item "Q3" {
        pos 400 430
        width 160
        color #ffffff
        text-color #111111
    }
    item "Q4" {
        pos 600 430
        width 160
        color #ffffff
        text-color #111111
    }
    link "Q1" "Q2" {
        display arrow
        color #333333
    }
    link "Q2" "Q3" {
        display arrow
        color #333333
    }
    link "Q3" "Q4" {
        display arrow
        color #333333
    }
    item "Dev feature complete" {
        pos 0 355
        width 160
        font-size 16
        color #A5D6A7
        text-color #111111
    }
    item "2/15" {
